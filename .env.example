# ====================================================================
# Configuration Template - Penghu Climate-Aware Smart Tourism
# ====================================================================
# Salin file ini menjadi `.env` lalu isi dengan kredensial rahasia Anda.
# Jangan pernah mem-push file `.env` yang berisi key asli ke GitHub!

# Google Cloud Places API Key (Dibutuhkan jika ingin menarik rating & ulasan dari Google)
# Dapatkan di: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=AIzaSy_MASUKKAN_GOOGLE_API_KEY_ANDA_DISINI

# Open-Meteo API (Gratis, tanpa API key secara default. Kosongkan jika pakai tier publik)
OPEN_METEO_API_KEY=

# Central Weather Administration (CWA Taiwan) Open Data Key (Opsional)
# Dapatkan di: https://opendata.cwa.gov.tw/user/authkey
CWA_API_KEY=

# Supabase / PostgreSQL Connection String (Untuk deployment backend nanti)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/penghu_smart_travel
